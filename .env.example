# Copy to .env.local for native development, or .env for Docker Compose.
# Never commit a file containing real values.

# --- Browser-safe (exposed to the client bundle) ---
# Local Supabase (via `supabase start`) prints these; for production, use your
# hosted project's values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-anon-or-publishable-key

# --- Server-only secrets. NEVER prefix these with NEXT_PUBLIC_. ---
SUPABASE_SECRET_KEY=replace-with-service-role-or-secret-key
# Direct Postgres connection string, used only by Drizzle for admin analytics
# queries. Local default shown; production uses Supabase's pooled connection string.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional: set only if the app is ever called from a different origin
# (e.g. a separate mobile client). Leave unset for normal same-origin use.
# ALLOWED_ORIGIN=https://campuspulse.example.edu

NODE_ENV=development
